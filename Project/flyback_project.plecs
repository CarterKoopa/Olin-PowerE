  Timeout       ""
  Solver        "auto"
  MaxStep       "1e-3"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "10"
  ZCStepSize    "1e-9"
  RelTol        "1e-3"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "3"
  DatatypeInheritanceConflictMsg "2"
  ContSampleTimeConflictMsg "2"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "fs = 50e3;\nts = 1/fs;\n\nR = 5;\nVo = 10;\nVg = 48;"
"\nalpha = 0.70;\nd = 0.35;\n\nM = Vo/Vg;\n\n%L = ((ts*R)/2) * (d/M)^2;\n%a = "
"(Vo/Vg)*((sqrt(alpha) - d)/d);\n\na = 0.29\nL = 141e-6\n\nRr = (1/(a^2))*R\nV"
"r = (1/a)*Vo\n\nK = (2/ts)*(L/R)\n\nIpk = sqrt(K)*ts*(Vo/L)\n\nVcomp = (3/20)"
"*Ipk + (13/10)\n\n% Parasitic Capacitances\nCds = 1.1e-9;\nCalpha = 0;\nLl = "
"L/111\n\nRsb = 62;\nCsb = 3.3e-9;\n\nCcl = 33.7e-9;\nRcl = 3917;\n\n% Paramet"
"erized Clamp\n% $Vcp = 49\n% Kcp = Vcp/Vr\n% Cl_pwr = (1/(2*ts))*(Ipk^2)*(Ll)"
"*(1/(1-(1/Kcp)))\n% Rcl = (Vcp^2)/Cl_pwr\n\n% Auxillary Windings\nVaux = 18\n"
"aaux = (Vaux/Vg) * ((sqrt(alpha) - d)/d)\nRaux = Vaux / .03"
  InitialState  "1"
  SystemState   ""
  TaskingMode   "1"
